  "claims": [
   {
    "statement": "Xbox One X no power: check 12 V, 5 V standby, then 1.1 V, 3.3 V and 1.8 V standby; with all present suspect the southbridge.",
    "evidence": "Diagnostic steps.",
    "quote": "",
    "at": ""
   },
   {
    "statement": "Missing 3.3 V standby = U54 (TPS56C215), which needs 1.8 V standby to start.",
    "evidence": "Diagnostic and repair steps.",
    "quote": "",
    "at": ""
   },
   {
    "statement": "A common pattern—3.3 V line at about 2.4 V and 1.8 V at about 0.44 V—is caused by HDMI retimer U29 (TDP158); removing it lets the console turn on briefly.",
    "evidence": "Diagnostic steps.",
    "quote": "",
    "at": ""
   },
   {
    "statement": "With the PSU removed, 12 V input reads about 0.400–0.500 in diode mode; 0.000 is a short.",
    "evidence": "Repair steps.",
    "quote": "",
    "at": ""
   }
  ],
  "procedure": [
   "Measure 12 V and standby rails.",
   "Diode-check 12 V input with PSU removed.",
   "Replace U54 if 3.3 V missing.",
   "If 3.3 V ~2.4 V and 1.8 V ~0.44 V, replace retimer U29."
  ],
