  "claims": [
   {
    "statement": "Normal iPad 6 boot draw climbs about 0.050 → 0.060 → 0.100 A and up toward 1 A.",
    "evidence": "Note on boot sequence.",
    "quote": "",
    "at": ""
   },
   {
    "statement": "An instant spike above 1 A suggests a short on VCC_MAIN, the Wi-Fi IC or PMIC; an instant 0.150 A that cycles suggests Tristar failure.",
    "evidence": "Current behaviour table.",
    "quote": "",
    "at": ""
   },
   {
    "statement": "A healthy battery reads 3.7–4.2 V; find shorts with thermal camera or rosin and replace the cap, Wi-Fi IC or Tristar/Hydra.",
    "evidence": "Diagnostic and repair steps.",
    "quote": "",
    "at": ""
   }
  ],
  "procedure": [
   "Check battery voltage (3.7–4.2 V).",
   "Boot on DCPS and note draw pattern.",
   "Diode-check VCC_MAIN caps for shorts.",
   "Locate hot component (thermal camera/rosin); replace cap, Wi-Fi IC or charging IC."
  ],
