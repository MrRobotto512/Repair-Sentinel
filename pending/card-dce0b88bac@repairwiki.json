  "claims": [
   {
    "statement": "Galaxy Z Fold 4 stuck on the charging animation with a dead short (about 0.09 Ω) on V_BATT is usually a failed ASL01 charging IC next to the battery connector FPC.",
    "evidence": "Problem description and diagnostics.",
    "quote": "",
    "at": ""
   },
   {
    "statement": "With ASL01 removed V_BATT read about 19 MΩ; after fitting a new one about 2.16 kΩ / 0.469 in diode mode (normal).",
    "evidence": "Repair steps.",
    "quote": "",
    "at": ""
   }
  ],
  "procedure": [
   "Measure V_BATT near the FPC connectors.",
   "Inject 1 V (1–2 A) with rosin; ASL01 heats.",
   "Remove ASL01; confirm short clears.",
   "Fit new ASL01; re-measure; test boot and charge."
  ],
  "measurements": [
   {
