  "claims": [
   {
    "statement": "Poco X3 Pro charging: check 5 V VBUS arrives on the main board from the sub board (jumper if missing), then 5 V at OVP_IN and OVP_OUT (jumper across a burnt OVP), then VPH_OUT from the charging IC.",
    "evidence": "Diagnostic steps.",
    "quote": "",
    "at": ""
   },
   {
    "statement": "The charging bootcap (not grounded) should show about 7–9 V on one side and 3–4 V on the VPH side; the same voltage on both sides means a faulty charging IC; a shorted/missing bootcap gives fake charging.",
    "evidence": "Diagnostic steps.",
    "quote": "",
    "at": ""
   }
  ],
  "procedure": [
   "Try a known-good OEM battery for slow charging.",
   "Check VBUS on main board.",
   "Check OVP_IN/OVP_OUT.",
   "Check VPH_OUT and shorts near charging IC.",
   "Check bootcap voltages; replace charging IC."
  ],
