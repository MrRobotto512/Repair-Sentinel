  "claims": [
   {
    "statement": "iPad 7 charge path: 5 V at the input filter, then through filters F3700/F3750 to a MOSFET (Q8550 with DZ8550/R8550), then Tristar U1700.",
    "evidence": "Diagnostic steps.",
    "quote": "",
    "at": ""
   },
   {
    "statement": "Less than 5 V (e.g. 2 V) at the MOSFET means F3700/F3750 are faulty.",
    "evidence": "Diagnostic steps.",
    "quote": "",
    "at": ""
   },
   {
    "statement": "Tristar U1700 (610A3B) failure, often from poor cables, shows as charging only when off or only in one plug orientation; it is not underfilled.",
    "evidence": "Diagnostic and repair steps.",
    "quote": "",
    "at": ""
   }
  ],
  "procedure": [
   "Test a new battery; inspect the port.",
   "Measure 5 V at the input filter; replace port flex if missing.",
   "Measure at MOSFET; replace F3700/F3750 if low.",
   "Check MOSFET output (Q8550/DZ8550/R8550).",
   "Replace Tristar U1700."
