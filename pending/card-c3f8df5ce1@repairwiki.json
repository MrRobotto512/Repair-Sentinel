  "claims": [
   {
    "statement": "No IMEI and no modem firmware means the baseband CPU isn't talking to the CPU; the usual cause on iPhone 12 Pro Max is top/bottom board disconnection.",
    "evidence": "Diagnostic steps.",
    "quote": "",
    "at": ""
   },
   {
    "statement": "Baseband PMU outputs (phone on): SMPS1_6 0.752 V, SMPS2 1.224 V, SMPS3 0.824 V, SMPS4 1.88 V, SMPS5 0.752 V, SMPS7 0.752 V.",
    "evidence": "Diagnostic steps.",
    "quote": "",
    "at": ""
   },
   {
    "statement": "A missing PMU voltage isn't necessarily a bad PMU; test in an iSocket first because a top-board signal may be missing.",
    "evidence": "Diagnostic steps.",
    "quote": "",
    "at": ""
   }
  ],
  "procedure": [
   "Measure the six BB PMU rails with phone on.",
   "Split and inspect for ripped pads.",
   "Test in iSocket; reball sandwich if IMEI returns.",
   "Diode-check lines to the BB CPU; reball BB CPU/PMU if open under them."
  ],
