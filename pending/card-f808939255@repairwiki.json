  "claims": [
   {
    "statement": "iPhone XR charging at 0.013 A and drawing about 82 mA before power-on on a DC supply usually needs Yangtze U3300 (charging IC) replaced; a liquid-damaged earpiece flex can also cause it.",
    "evidence": "Solution.",
    "quote": "",
    "at": ""
   },
   {
    "statement": "The shield over Yangtze is very tough; add 138 °C low-melt solder to its edges; baseband and WTR under it can float.",
    "evidence": "Note.",
    "quote": "",
    "at": ""
   }
  ],
  "procedure": [
   "Test with earpiece flex unplugged.",
   "Remove shield with low-melt solder.",
   "Replace Yangtze U3300; confirm the 82 mA draw is gone."
  ],
