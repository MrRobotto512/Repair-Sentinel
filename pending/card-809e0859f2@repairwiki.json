  "claims": [
   {
    "statement": "Reference diode-mode and resistance-to-ground readings for test points on the front of a working Steam Deck LCD mainboard rev. G, grouped by board sector (A1–F4); measured with red probe on ground (battery connector housing).",
    "evidence": "Table 1 on the source page.",
    "quote": "",
    "at": ""
   },
   {
    "statement": "Several points sit near ground by design (e.g. D3-01/02 ~0.033 V / 17–20 Ω, C3-05 0.01 V / 0.7 Ω), so a low reading there is not automatically a short.",
    "evidence": "Table values.",
    "quote": "",
    "at": ""
   }
  ],
  "procedure": [
   "Locate the sector on the source page's annotated image.",
   "Compare your reading against the matching sector/point."
  ],
