  "claims": [
   {
    "statement": "SSD/flash: 808E000x EAP fail (SSD controller); 808F000x SMCU SSD>EMC; 808B00FF SSD controller watchdog; 808B0014, 80871001/1055/1062, 80894003/40AE flash controller errors; 80802081 SSD controller to APU comms failure—check caps behind the controller.",
    "evidence": "EMC errlog table.",
    "quote": "",
    "at": ""
   },
   {
    "statement": "SSD PMIC (DA9081/RT5127) rails: 80918000 0.8V_FC_VDD; 80912000 2.5V_DDR4_VPP; 80910200 1.2V_FC_VDDQMIO; 80910002 1.8V_FC_AVDD; 80910800 1.2V_FC_VDDQFIO; C0160203 SSD PMIC access error—check fuse F7004 on Slim, F7502 on EDM-03x.",
    "evidence": "EMC errlog table.",
    "quote": "",
    "at": ""
   },
   {
    "statement": "C0810002 HDMI Tx access error: the encoder's 1.8V_HDMI line has failed.",
    "evidence": "EMC errlog table.",
    "quote": "",
    "at": ""
   },
   {
    "statement": "USB/BT: 808C0D91 and 808C2092 USB Type-C error; C0920002 Type-C redriver access error; 80C00131 USB over-current; 80C00133–80C00137 and 80D00402 USB-Bluetooth firmware/device errors; B0082108 possibly Wi-Fi chip.",
    "evidence": "EMC errlog table.",
    "quote": "",
    "at": ""
   },
   {
    "statement": "80870003 Titania boot failed reading chip revision—check fuse F7001; 80C0012C BD drive detached; 80C00139 BD eject delayed.",
    "evidence": "EMC errlog table.",
    "quote": "",
    "at": ""
   },
   {
    "statement": "E31223DE, E2E00F1D, E2000000, E1200000 relate to the southbridge—clean flux underneath or let it cool; 80800014 fatal shutdown possibly TPM-related.",
    "evidence": "EMC errlog table.",
    "quote": "",
    "at": ""
   }
  ],
  "procedure": [
   "Read EMC errlog over UART.",
   "SSD PMIC codes: measure the named rail and its fuse.",
   "USB/BT codes: check Type-C redriver, ports and BT module.",
   "Southbridge E-codes: clean flux under southbridge after rework."
  ],
