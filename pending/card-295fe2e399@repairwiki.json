  "claims": [
   {
    "statement": "iPhone 15 Pro stuck at 1%, showing 0% when plugged in and restarting every 3 minutes with panic 0xa1—even with new battery and port—is typically a PMIC fried by water.",
    "evidence": "Problem description.",
    "quote": "",
    "at": ""
   },
   {
    "statement": "Battery connector diode values (ZXW pins): pin 1 SDA 0.439, pin 2 SCL 0.548, pin 5 VCELL_NEG OL, pin 6 VCELL_POS 0.505.",
    "evidence": "Diagnostic steps.",
    "quote": "",
    "at": ""
   },
   {
    "statement": "With only the charge flex and charger connected: pin 1 1.5 V, pin 2 1.8 V, pin 5 0.6 V, pin 6 0.6 V. Bad readings mean PMIC.",
    "evidence": "Diagnostic steps.",
    "quote": "",
    "at": ""
   }
  ],
  "procedure": [
   "Test known-good battery and charge port.",
   "Inspect battery connector pins.",
   "Diode-check pins 1, 2, 5, 6.",
   "Measure voltages with charger on charge flex only.",
   "Replace PMIC if abnormal."
  ],
