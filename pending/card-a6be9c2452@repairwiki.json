  "claims": [
   {
    "statement": "An iPhone 11 bootloop traced to I2C_AOP_SDA being pulled down by a faulty audio IC U4700: SDA read 0.060 instead of about 0.342 in diode mode at the front proximity FPC (SCL normal about 0.318).",
    "evidence": "Diagnostic steps.",
    "quote": "",
    "at": ""
   },
   {
    "statement": "Removing U4700 cleared the short and the phone booted without audio; fitting a new U4700 fixed it.",
    "evidence": "Repair steps.",
    "quote": "",
    "at": ""
   }
  ],
  "procedure": [
   "Diode-check I2C_AOP_SDA/SCL at the front prox FPC.",
   "If SDA is low, remove U4700 and re-measure.",
   "Fit replacement U4700; test audio."
  ],
