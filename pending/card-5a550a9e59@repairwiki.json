  "claims": [
   {
    "statement": "iPhone 15 / 15 Plus with no touch on any screen is commonly a short on PP5V1_TOUCH_VDDTX_S2_CONN caused by capacitor C9202 under an EMI shield.",
    "evidence": "Problem description.",
    "quote": "",
    "at": ""
   },
   {
    "statement": "At the display connector that rail normally reads about 0.571 in diode mode; 0.00 and 0–1 Ω to ground confirms the short.",
    "evidence": "Diagnostic steps.",
    "quote": "",
    "at": ""
   },
   {
    "statement": "Injecting 1–2 V shows no heat until the shield flap over C9202 is cut; with rosin applied, C9202 heats up.",
    "evidence": "Diagnostic steps.",
    "quote": "",
    "at": ""
   },
   {
    "statement": "Replace C9202 with a 10 µF capacitor of the same package size.",
    "evidence": "Repair steps.",
    "quote": "",
    "at": ""
   }
  ],
  "procedure": [
   "Diode-check PP5V1_TOUCH_VDDTX_S2_CONN at the display FPC (good ~0.571).",
   "Measure resistance to ground.",
   "Cut only the shield flap over C9202.",
   "Apply rosin and inject 1–2 V to confirm.",
   "Replace C9202 with 10 µF; clean and test touch."
  ],
