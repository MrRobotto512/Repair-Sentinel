  "claims": [
   {
    "statement": "A false Temperature Too High warning on a cool iPhone 16 Pro, persisting after battery/port swaps and restore, shows about 0.8–0.9 V on gpio_aop_from_baro_int_l.",
    "evidence": "Diagnostic steps.",
    "quote": "",
    "at": ""
   },
   {
    "statement": "Fix: pull that line up to 1.8 V from pp1v8_s2_dock_conn through a 1 kΩ resistor and fine jumper.",
    "evidence": "Repair steps.",
    "quote": "",
    "at": ""
   }
  ],
  "procedure": [
   "Confirm the phone is cool and idle draw normal.",
   "Measure gpio_aop_from_baro_int_l (~0.8–0.9 V = fault).",
   "Fit 1 kΩ from pp1v8_s2_dock_conn to the affected dock FPC pad."
  ],
  "measurements": [
   {
    "point": "gpio_aop_from_baro_int_l (faulty)",
    "expect": "0.8-0.9",
