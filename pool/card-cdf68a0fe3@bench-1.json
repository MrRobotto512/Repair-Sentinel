  "claims": [
   {
    "statement": "The Dialog DA9065 PMIC takes a +5V STBY input and generates +3.3V STBY, +1.9V, +1.15V, and +1.8V STBY rails primarily for the Southbridge IC.",
    "evidence": "Document labels IN: +5V STBY and outputs +3.3V STBY, +1.15V, +1.9V, and +1.8V STBY on pin 27.",
    "quote": "DA9065 is a power management integrated circuit (PMIC). This IC has different buck converters to generate different power rails. The most important power rails will go the Southbridge IC.",
    "at": ""
   },
   {
    "statement": "Pins 5, 10, 11, 17, 23, 30, and 31 of the DA9065 PMIC route to or connect with +5V STBY fuse F7003.",
    "evidence": "Pinout diagram lists PIN 5, 10, 11, 17, 23 as '+- 5V (F7003)' and PIN 30, 31 as 'Goes to fuse F7003'.",
    "quote": "PIN 5 = +- 5V (F7003) ... PIN 30 = Goes to fuse F7003 PIN 31 = Goes to fuse F7003",
    "at": ""
   }
  ],
